{
  "name": "@o2js/core",
  "version": "0.4.0",
  "description": "A minimal, provider-agnostic OAuth 2.0 client for Node.js.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "oauth",
    "oauth2",
    "oauth-2.0",
    "openid",
    "openid-connect",
    "oidc",
    "pkce",
    "authorization-code",
    "refresh-token",
    "authentication",
    "authorization",
    "node",
    "nodejs",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jose": "^6.2.15"
  }
}